{
  "info": {
    "name": "SpeechMatrix STT API â€S” Day 4 Full Test Suite",
    "description": "Complete auth testing collection.\n\nQuick start:\n1. Import this file into Postman\n2. Run the 'Auth Flow' folder in order using Collection Runner\n3. All tokens are auto-saved â€” no manual copy/paste needed\n4. Check the 'Tests' tab on each request to see pass/fail",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080" },
    { "key": "token",         "value": "" },
    { "key": "userId",        "value": "" },
    { "key": "testEmail",     "value": "postman_test@sttapp.com" },
    { "key": "testPassword",  "value": "PostmanTest1" },
    { "key": "testName",      "value": "Postman Tester" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "1 â€” Auth Flow (run in order)",
      "item": [

        {
          "name": "01 Register",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// Ensure a fresh email on every run",
                "const ts = Date.now();",
                "pm.collectionVariables.set('testEmail', `test_${ts}@sttapp.com`);"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Has JWT token', () => {",
                "    const r = pm.response.json();",
                "    pm.expect(r.token).to.be.a('string').and.have.length.above(10);",
                "    pm.collectionVariables.set('token', r.token);",
                "    pm.collectionVariables.set('userId', r.id);",
                "});",
                "pm.test('Token type is Bearer', () =>",
                "    pm.expect(pm.response.json().type).to.eql('Bearer'));",
                "pm.test('Has user id (number)', () =>",
                "    pm.expect(pm.response.json().id).to.be.a('number'));",
                "pm.test('Email matches input', () =>",
                "    pm.expect(pm.response.json().email).to.include('sttapp.com'));",
                "pm.test('Response time < 2000ms', () =>",
                "    pm.expect(pm.response.responseTime).to.be.below(2000));"
              ]}
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }
          }
        },

        {
          "name": "02 Register â€” duplicate email (expect 400)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400 for duplicate email', () =>",
              "    pm.response.to.have.status(400));",
              "pm.test('Error message mentions already registered', () =>",
              "    pm.expect(pm.response.json().message).to.include('already'));",
              "pm.test('No token in error response', () =>",
              "    pm.expect(pm.response.json().token).to.be.undefined);"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{testName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }
          }
        },

        {
          "name": "03 Register â€” weak password (expect 400)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Password field error present', () => {",
              "    const details = pm.response.json().details;",
              "    pm.expect(details).to.have.property('password');",
              "});"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test\",\n  \"email\": \"weak@test.com\",\n  \"password\": \"abc\"\n}" }
          }
        },

        {
          "name": "04 Register â€” invalid email format (expect 400)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Email field error present', () =>",
              "    pm.expect(pm.response.json().details).to.have.property('email'));"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test\",\n  \"email\": \"notanemail\",\n  \"password\": \"SecurePass1\"\n}" }
          }
        },

        {
          "name": "05 Register â€” empty body (expect 400)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Has details with field errors', () =>",
              "    pm.expect(pm.response.json().details).to.be.an('object'));"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register" },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },

        {
          "name": "06 Login â€” correct credentials",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns fresh JWT', () => {",
              "    const r = pm.response.json();",
              "    pm.expect(r.token).to.be.a('string');",
              "    pm.collectionVariables.set('token', r.token);",
              "});",
              "pm.test('expiresInMs is 86400000 (24h)', () =>",
              "    pm.expect(pm.response.json().expiresInMs).to.eql(86400000));",
              "pm.test('issuedAt field exists', () =>",
              "    pm.expect(pm.response.json().issuedAt).to.exist);"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}" }
          }
        },

        {
          "name": "07 Login â€” wrong password (expect 401)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Error is Unauthorized', () =>",
              "    pm.expect(pm.response.json().error).to.eql('Unauthorized'));",
              "pm.test('No token returned', () =>",
              "    pm.expect(pm.response.json().token).to.be.undefined);"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPassword99\"\n}" }
          }
        },

        {
          "name": "08 Login â€” unknown email (expect 401)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nobody@nowhere.com\",\n  \"password\": \"SecurePass1\"\n}" }
          }
        },

        {
          "name": "09 GET /me â€” valid token",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('authenticated is true', () =>",
              "    pm.expect(pm.response.json().authenticated).to.be.true);",
              "pm.test('email matches test user', () =>",
              "    pm.expect(pm.response.json().email).to.include('sttapp.com'));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me" }
          }
        },

        {
          "name": "10 GET /me â€” no token (expect 401 JSON)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "pm.test('Content-Type is JSON (not HTML)', () =>",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Has status field 401', () =>",
              "    pm.expect(pm.response.json().status).to.eql(401));",
              "pm.test('Has message field', () =>",
              "    pm.expect(pm.response.json().message).to.be.a('string').and.not.empty);"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me" }
          }
        },

        {
          "name": "11 GET /me â€” tampered token (expect 401)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]}
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "eyJhbGciOiJIUzI1NiJ9.TAMPERED.signature" }]},
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me" }
          }
        },

        {
          "name": "12 GET /profile â€” check stats shape",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has all profile fields', () => {",
              "    const r = pm.response.json();",
              "    pm.expect(r).to.have.all.keys('id','name','email','createdAt','totalTranscriptions','totalWords','totalDurationSecs');",
              "});",
              "pm.test('totalTranscriptions is a number', () =>",
              "    pm.expect(pm.response.json().totalTranscriptions).to.be.a('number'));",
              "pm.test('New user has 0 transcriptions', () =>",
              "    pm.expect(pm.response.json().totalTranscriptions).to.eql(0));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/profile" }
          }
        },

        {
          "name": "13 POST /change-password â€” wrong current",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401 for wrong current password', () =>",
              "    pm.response.to.have.status(401));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/change-password" },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"WrongPass99\",\n  \"newPassword\": \"NewSecure1\"\n}" }
          }
        },

        {
          "name": "14 POST /logout â€” blacklist token",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Success message', () =>",
              "    pm.expect(pm.response.json().message).to.include('successfully'));"
            ]}
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout" }
          }
        },

        {
          "name": "15 GET /me â€” after logout (expect 401)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Token rejected after logout â€” status 401', () =>",
              "    pm.response.to.have.status(401));",
              "pm.test('Response is JSON', () =>",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('json'));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me" }
          }
        }

      ]
    },

    {
      "name": "2 â€” BCrypt Diagnostics (dev only)",
      "item": [

        {
          "name": "BCrypt analyze â€” strong password",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Hashes are different (random salt)', () =>",
              "    pm.expect(r.hashesAreDifferent).to.be.true);",
              "pm.test('Hash length is 60', () =>",
              "    pm.expect(r.hashLength).to.eql(60));",
              "pm.test('BCrypt strength is 12', () =>",
              "    pm.expect(r.bcryptStrength).to.eql(12));",
              "pm.test('Prefix is $2a$12$', () =>",
              "    pm.expect(r.hashPrefix).to.eql('$2a$12$'));",
              "pm.test('Both hashes verify OK', () => {",
              "    pm.expect(r.hash1VerifiesOk).to.be.true;",
              "    pm.expect(r.hash2VerifiesOk).to.be.true;",
              "});"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/dev/bcrypt?password=SecurePass1" }
          }
        },

        {
          "name": "BCrypt verify â€” correct password",
          "event": [{
            "listen": "prerequest",
            "script": { "exec": [
              "// Pre-hash a password to verify against",
              "// In real use, get the hash from your DB or a previous bcrypt response"
            ]}
          },
          {
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('matches is true', () =>",
              "    pm.expect(pm.response.json().matches).to.be.true);"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/dev/bcrypt/verify" },
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"password123\",\n  \"hash\": \"$2a$12$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2uheWG/igi.\"\n}" }
          }
        },

        {
          "name": "Token inspect (requires valid token)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Has expiresAt', () => pm.expect(r.expiresAt).to.exist);",
              "pm.test('Token is still valid (remainingMs > 0)', () =>",
              "    pm.expect(r.remainingMs).to.be.above(0));",
              "pm.test('TTL is ~24h', () =>",
              "    pm.expect(r.configuredTtlMs).to.eql(86400000));"
            ]}
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/dev/token/inspect" }
          }
        },

        {
          "name": "Security routes map",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has publicRoutes', () =>",
              "    pm.expect(pm.response.json().publicRoutes).to.be.an('array'));",
              "pm.test('Has protectedRoutes', () =>",
              "    pm.expect(pm.response.json().protectedRoutes).to.be.an('array'));"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/dev/security/routes" }
          }
        }

      ]
    }

  ]
}
